{
    "name": "slay-lang",
    "main": "./extension.js",
    "displayName": "SlayLang",
    "publisher": "fynr1x",
    "icon": "slay-icon.png",
    "version": "0.2.2",
    "engines": { "vscode": "^1.60.0" },
    "activationEvents": ["onLanguage:slay"],
    "repository": {
        "type": "git",
        "url": "https://github.com/fynr1x/SlayLang"
    },
    "contributes": {
        "languages": [{
            "id": "slay",
            "aliases": ["SlayLang", "slay"],
            "extensions": [".slay"],
            "configuration": "./language-configuration.json",
            "icon": {
                "light": "./slay-icon.png",
                "dark": "./slay-icon.png"
            }
        }],
        "grammars": [{
            "language": "slay",
            "scopeName": "source.slay",
            "path": "./syntaxes/slay.tmLanguage.json"
        }]
    }
}