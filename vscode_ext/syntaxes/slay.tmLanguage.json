{
    "name": "SlayLang",
    "scopeName": "source.slay",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#operators" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.double-slash.slay",
            "match": "//.*$"
        },
        "strings": {
            "name": "string.quoted.double.slay",
            "begin": "\"",
            "end": "\"",
            "patterns": [{ "name": "constant.character.escape.slay", "match": "\\\\." }]
        },
        "numbers": {
            "name": "constant.numeric.slay",
            "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "constant.language.slay",
                    "match": "\\b(nocap|cap|ghosted)\\b"
                },
                {
                    "name": "keyword.control.slay",
                    "match": "\\b(sus|mid|tho|grind|spin|dip|skip|yeet)\\b"
                },
                {
                    "name": "keyword.declaration.slay",
                    "match": "\\b(vibe|lockedin|cook)\\b"
                }
            ]
        },
        "builtins": {
            "name": "support.function.builtin.slay",
            "match": "\\b(yap|rant|snoop|numify)\\b"
        },
        "operators": {
            "name": "keyword.operator.slay",
            "match": "(==|!=|>=|<=|>|<|\\+|-|\\*\\*|\\*|/|%|=|&&|\\|\\||nah)"
        },
        "identifiers": {
            "name": "variable.other.slay",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
    }
}