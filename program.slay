vibe numbers[] = [5,10,15,20,25]

cook average(arr) {
    vibe total = 0

    spin (vibe i = 0; i < 5; i = i + 1) {
        total = total + arr[i]
    }

    yeet total / 5
}

cook grade(score) {
    sus(score >= 90) {
        yeet "A"
    } mid(score >= 80) {
        yeet "B"
    } mid(score >= 70) {
        yeet "C"
    } tho {
        yeet "F"
    }
}

yap(grade(95))
yap(grade(85))
yap(grade(75))
yap(grade(65))