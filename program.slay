// ==========================================
// SLAYLANG EXTREME INTERPRETER TORTURE TEST
// ==========================================


// ---------- BASIC MATH ----------

cook square(x) {
    yeet x * x
}


cook cube(x) {
    yeet x * x * x
}


cook absolute(x) {
    sus (x < 0) {
        yeet x * -1
    }

    yeet x
}


// ---------- TYPE CONVERSION ----------

cook conversionTest() {

    yap("===== TYPE CONVERSION =====")

    yap(intify(10.99))
    yap(intify(10.01))

    yap(floatify(10))

    yap("Float math:")
    yap(floatify(5) / 2)
}



// ---------- RECURSION ----------

cook factorial(n) {

    sus (n <= 1) {
        yeet 1
    }

    yeet n * factorial(n - 1)
}


cook fibonacci(n) {

    sus (n <= 0) {
        yeet 0
    }

    sus (n == 1) {
        yeet 1
    }

    yeet fibonacci(n - 1) + fibonacci(n - 2)
}


// ---------- ACKERMANN ----------

cook ackermann(m, n) {

    sus (m == 0) {
        yeet n + 1
    }

    sus (n == 0) {
        yeet ackermann(m - 1, 1)
    }

    yeet ackermann(m - 1, ackermann(m, n - 1))
}


// ---------- NUMBER THEORY ----------

cook gcd(a, b) {

    grind (b != 0) {

        vibe temp = b
        b = a % b
        a = temp
    }

    yeet a
}


cook lcm(a, b) {

    yeet intify((a * b) / gcd(a, b))
}


cook isPrime(n) {

    sus (n <= 1) {
        yeet cap
    }


    spin (vibe i = 2; i * i <= n; i = i + 1) {

        sus (n % i == 0) {
            yeet cap
        }
    }


    yeet nocap
}



// ---------- LOOP STRESS ----------

cook sumTo(n) {

    vibe total = 0

    spin (vibe i = 1; i <= n; i = i + 1) {

        total = total + i
    }


    yeet total
}


cook countdown(n) {

    grind (n > 0) {

        n = n - 1
    }

    yeet n
}



// ---------- SCOPE TEST ----------

cook scopeTest(x) {

    vibe hidden = 500

    vibe doubled = x * 2

    yeet hidden + doubled
}



// ---------- NESTED CALLS ----------

cook megaMath(x) {

    yeet factorial(square(x))
}



// ---------- COMPARISON ----------

cook compare(a, b) {

    sus (a > b) {

        yeet 1
    }


    sus (a == b) {

        yeet 0
    }


    yeet -1
}



// ==========================================
// EXECUTION
// ==========================================


yap("===== BASIC MATH =====")

yap(square(5))
yap(cube(3))
yap(absolute(-50))


conversionTest()


yap("===== RECURSION =====")

yap(factorial(10))
yap(fibonacci(15))


yap("===== ACKERMANN =====")

yap(ackermann(2, 3))


yap("===== NUMBER THEORY =====")

yap(gcd(252, 105))
yap(lcm(12, 18))


sus (isPrime(97)) {
    yap("97 PRIME")
} tho {
    yap("97 NOT PRIME")
}


sus (isPrime(100)) {
    yap("100 PRIME")
} tho {
    yap("100 NOT PRIME")
}


yap("===== LOOPS =====")

yap(sumTo(1000))
yap(countdown(10000))


yap("===== SCOPE =====")

yap(scopeTest(20))


yap("===== NESTED CALLS =====")

yap(megaMath(5))


yap("===== COMPARISON =====")

yap(compare(10, 5))
yap(compare(5, 5))
yap(compare(2, 9))


yap("===== FINISHED =====")